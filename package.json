{
  "name": "antigravity-account-switcher",
  "displayName": "Antigravity Account Switcher",
  "description": "Switch between multiple accounts in Antigravity to bypass model rate limits. Works on Windows, Linux, and macOS.",
  "version": "1.0.2",
  "publisher": "fusionlancers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surendrad24/antigravity-account-switcher"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-switcher.saveProfile",
        "title": "Antigravity: Save Current Profile"
      },
      {
        "command": "antigravity-switcher.switchProfile",
        "title": "Antigravity: Switch Profile"
      },
      {
        "command": "antigravity-switcher.deleteProfile",
        "title": "Antigravity: Delete Profile"
      },
      {
        "command": "antigravity-switcher.listProfiles",
        "title": "Antigravity: List Profiles"
      },
      {
        "command": "antigravity-switcher.setActiveProfile",
        "title": "Antigravity: Set Active Profile (No Restart)"
      },
      {
        "command": "antigravity-switcher.showActivityLog",
        "title": "Antigravity: Show Switcher Activity Log"
      },
      {
        "command": "antigravity-switcher.runDiagnostics",
        "title": "Antigravity: Run Switcher Diagnostics"
      },
      {
        "command": "antigravity-switcher.healthCheckProfiles",
        "title": "Antigravity: Health Check Profiles"
      },
      {
        "command": "antigravity-switcher.exportProfile",
        "title": "Antigravity: Export Profile Folder"
      },
      {
        "command": "antigravity-switcher.importProfile",
        "title": "Antigravity: Import Profile Folder"
      },
      {
        "command": "antigravity-switcher.repairCurrentSession",
        "title": "Antigravity: Repair Current Session Cache"
      },
      {
        "command": "antigravity-switcher.exportProfileEncrypted",
        "title": "Antigravity: Export Profile Encrypted"
      },
      {
        "command": "antigravity-switcher.importProfileEncrypted",
        "title": "Antigravity: Import Profile Encrypted"
      },
      {
        "command": "antigravity-switcher.showAnalytics",
        "title": "Antigravity: Show Profile Analytics"
      }
    ],
    "configuration": {
      "title": "Antigravity Account Switcher",
      "properties": {
        "antigravitySwitcher.maxProfiles": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of profiles allowed (reflected in status bar slots)"
        },
        "antigravitySwitcher.profilesDirectory": {
          "type": "string",
          "default": "",
          "description": "Custom directory to store profiles (leave empty for platform default)"
        },
        "antigravitySwitcher.profilePin": {
          "type": "string",
          "default": "",
          "description": "Optional PIN required before switching/deleting profiles"
        },
        "antigravitySwitcher.autoSnapshotMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "description": "Auto-save snapshot interval in minutes (0 disables)"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
